MONGODB_URI=<ping me for the connection string>

JWT_SECRET=event-premium-secret-key-change-in-production-2026

# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

GOOGLE_CLIENT_ID=<your-google-client-id>
GOOGLE_CLIENT_SECRET=<your-google-client-secret>

GROQ_API_KEY=<your-groq-api-key>

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=<your-email>
SMTP_PASS=<your-app-password>
SMTP_FROM=<your-email>

NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=<your-google-maps-key>

# Stripe (test mode keys from https://dashboard.stripe.com/test/apikeys)
STRIPE_SECRET_KEY=<your-stripe-test-secret-key>
# From `stripe listen --forward-to localhost:3000/api/webhooks/stripe` in dev,
# or the webhook's signing secret from the Stripe Dashboard in production.
STRIPE_WEBHOOK_SECRET=<your-stripe-webhook-signing-secret>
